# P&ID Intelligence Agent — development configuration.
#
# Copy to .env for local development. .env is development-only and is gitignored:
# production credentials belong in the environment or a secret manager, never in a file
# in the repository. No real key may be committed here.
#
# Every value below is optional except OPENAI_API_KEY and CORPUS_ROOT. The defaults shown
# are the ones the service applies when the variable is absent, and each default chooses
# the safer behaviour.

# ---------------------------------------------------------------------------
# Model plane
# ---------------------------------------------------------------------------

# Credential for the OpenAI Responses API. Never logged, never placed in model context,
# never returned by a tool, never written to session history.
OPENAI_API_KEY=

# Exactly one model identifier. There is no runtime model router: a comma- or
# whitespace-separated value is rejected at startup. Prefer the highest-capability
# Responses model provisioned for the project; accuracy comes before cost here.
OPENAI_MODEL=gpt-5

# Whether the provider retains responses upstream. Disabled by default because the local
# session is the authoritative conversation history and two owners of the same state
# create ambiguity. Changing this is a deliberate control-plane decision.
STORE_MODEL_RESPONSES=false

# ---------------------------------------------------------------------------
# Local state
# ---------------------------------------------------------------------------

# Root of the read-only engineering corpus. Resolved once at startup to an absolute path;
# startup fails if it is missing, is not a directory, or is unreadable. Walked
# recursively; .png, .pdf and .graphml are served and every other extension is ignored.
CORPUS_ROOT=data

# File-backed SQLite database. The Agents SDK creates and owns every table in it. The
# parent directory is created if absent and must be writable, or startup fails.
SQLITE_PATH=var/sessions.sqlite3

# ---------------------------------------------------------------------------
# Deadlines, admission and turn bounds
# ---------------------------------------------------------------------------

# Three independent budgets. No layer assumes another layer's timeout is sufficient.
RUN_DEADLINE_S=300.0          # whole agent episode, from admission to final item
MODEL_CALL_TIMEOUT_S=120.0    # one model call
TOOL_TIMEOUT_S=30.0           # one local tool call

# Maximum agent-loop turns. Exceeding it fails the request; a partial investigation is
# never returned as a finished engineering answer.
MAX_AGENT_TURNS=24

# Runs admitted concurrently across the process. A saturated service refuses with 429
# rather than queueing a request past its own deadline.
MAX_CONCURRENT_RUNS=4

# How many model-emitted tool calls the backend executes at once. Distinct from
# ModelSettings.parallel_tool_calls, which bounds what the model may emit.
MAX_FUNCTION_TOOL_CONCURRENCY=4

# Grace period for in-flight runs during shutdown.
SHUTDOWN_GRACE_S=30.0

# ---------------------------------------------------------------------------
# Model retry policy
# ---------------------------------------------------------------------------
# Bounded exponential backoff with jitter, applied by the SDK to transient provider and
# network failures only. Never an unbounded loop.

MODEL_MAX_RETRIES=2
MODEL_RETRY_INITIAL_DELAY_S=1.0
MODEL_RETRY_MAX_DELAY_S=20.0
MODEL_RETRY_MULTIPLIER=2.0
MODEL_RETRY_JITTER=true

# ---------------------------------------------------------------------------
# Corpus bounds
# ---------------------------------------------------------------------------

# Per-artifact size ceiling, checked from stat before any byte is read or encoded.
MAX_CORPUS_FILE_BYTES=33554432

# Page size for the corpus listing. A truncated page says so explicitly.
MAX_CORPUS_LIST_ENTRIES=200

# Lifetime of the corpus scan snapshot. 0 disables the cache; correctness never depends
# on it, only latency.
CORPUS_SCAN_CACHE_TTL_S=30.0

# Advisory ceiling on pages returned by one tool result.
MAX_PDF_PAGES_PER_TOOL_RESULT=8

# Render resolution for a single PDF page. Higher resolves small P&ID symbols at the cost
# of image size; a render exceeding MAX_CORPUS_FILE_BYTES is reported, not truncated.
PDF_RENDER_DPI=200

# Maximum pages reported by one text search.
MAX_PDF_TEXT_HITS=25

# Documents whose extracted page text is cached, keyed by file version.
PDF_CACHE_MAX_ENTRIES=8

# ---------------------------------------------------------------------------
# Graph query bounds
# ---------------------------------------------------------------------------
# A result that hits a bound states the truncation in its own text.

MAX_GRAPH_HOPS=4
MAX_GRAPH_NODES=200
MAX_GRAPH_EDGES=400
GRAPH_CACHE_MAX_ENTRIES=16

# ---------------------------------------------------------------------------
# Session registry
# ---------------------------------------------------------------------------
# This caches session objects, not conversation state. Eviction closes a Python object;
# it never deletes history.

SESSION_CACHE_MAX_ENTRIES=256
SESSION_CACHE_IDLE_S=900.0
SESSION_CACHE_SWEEP_INTERVAL_S=60.0

# Recent items retrieved per turn. Empty means the full history, which is the
# correctness-first default. A limit is a context-retrieval optimisation only: the
# database still holds every item.
SESSION_HISTORY_LIMIT=

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

# Request bodies above this are refused with 413 without being buffered in full.
MAX_REQUEST_BODY_BYTES=4194304

HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# SDK tracing. Export requires a credential, so this is inert without OPENAI_API_KEY.
ENABLE_TRACING=true

# CRITICAL, ERROR, WARNING, INFO or DEBUG. Case-insensitive.
LOG_LEVEL=INFO
