# Frontend configuration.
#
# Copy to .env.local for development. This project holds no OpenAI credentials, no backend
# database credentials and no corpus paths: the browser never calls a model, and the Node
# gateway never does either.

# ---------------------------------------------------------------------------
# Server-only
# ---------------------------------------------------------------------------

# Origin of the Python P&ID backend. Read by Node route handlers and never sent to the
# browser: browser code calls same-origin /api routes, so the backend topology stays
# private and CORS never enters the picture.
#
# A production build fails without it. In development it defaults to the value below,
# which matches the backend's own default.
BACKEND_BASE_URL=http://127.0.0.1:8000

# Connection timeout for non-streaming upstream calls, in milliseconds. Streaming calls are
# deliberately not given a client-side timeout: the run deadline belongs to the backend, and
# a long analysis is not a stalled connection.
BACKEND_CONNECT_TIMEOUT_MS=10000

# Gateway log verbosity: "silent", "default" or "debug". Request and response bodies are
# never logged at any level - they carry the question, the answer and corpus content.
FRONTEND_LOG_LEVEL=default

# ---------------------------------------------------------------------------
# Public (inlined into the browser bundle - never put a secret here)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_PRODUCT_NAME=P&ID Intelligence
